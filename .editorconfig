root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,yml,yaml,json,md,js,mjs,ts,tsx,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{tests/plans,tests/suites,bench/apps}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
