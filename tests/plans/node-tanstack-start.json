{
 "app": "node-tanstack-start",
 "facts": {
  "framework": "tanstackstart",
  "node": "lts (default)",
  "package-manager": "bun",
  "runtime": "node server (built)",
  "runtime-base": "distroless node (busybox shell)"
 },
 "image": {
  "cmd": [
   "node",
   ".output/server/index.mjs"
  ],
  "entrypoint": [],
  "env": [
   [
    "NODE_ENV",
    "production"
   ],
   [
    "PATH",
    "/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/busybox"
   ],
   [
    "npm_config_user_agent",
    "bun/ npm/? node/v{version:node|lts} linux x64"
   ],
   [
    "npm_lifecycle_event",
    "start"
   ],
   [
    "npm_package_name",
    "tanstack-start-example-basic"
   ]
  ],
  "layers": [
   "layer-shim",
   "layer-deps",
   "layer-app"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "kind": "toolchain",
    "parts": [
     "npm",
     "headers"
    ],
    "spec": "lts",
    "tool": "node"
   },
   "deps": [],
   "id": "node",
   "name": "node lts"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-fetch",
    "lockfile": "bun.lock",
    "lockfile_sha256": "c4d9787b71c76637cfe0e82e773af26113c351b167b8c2dd85fb4612c40e06b3",
    "manager": "bun"
   },
   "deps": [],
   "id": "npm-fetch",
   "name": "fetch packages"
  },
  {
   "action": {
    "exclude": [
     "**/node_modules"
    ],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-install",
    "manager": "bun",
    "scripts": "@biomejs/biome,@prisma/client,@prisma/engines,@swc/core,bcrypt,better-sqlite3,canvas,esbuild,node-sass,prisma,puppeteer,sharp,sqlite3",
    "target": "src"
   },
   "deps": [
    "npm-fetch",
    "source",
    "node"
   ],
   "id": "install",
   "name": "install node_modules"
  },
  {
   "action": {
    "argv": [
     "/bin/sh",
     "-c",
     "vite build && tsc --noEmit"
    ],
    "cwd": ".",
    "env": {
     "NEXT_TELEMETRY_DISABLED": "1",
     "NODE_ENV": "production",
     "npm_lifecycle_event": "build",
     "npm_package_name": "tanstack-start-example-basic"
    },
    "kind": "run",
    "network": true
   },
   "deps": [
    "node",
    "install"
   ],
   "id": "build",
   "name": "run vite build && tsc --noEmit"
  },
  {
   "action": {
    "kind": "resolve-node-base",
    "spec": "lts",
    "variant": "distroless"
   },
   "deps": [],
   "id": "base",
   "name": "resolve node lts runtime (distroless)"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "type": "node-shim"
    },
    "kind": "layer"
   },
   "deps": [
    "base"
   ],
   "id": "layer-shim",
   "name": "layer sh, env and node links"
  },
  {
   "action": {
    "dev": false,
    "kind": "npm-fetch",
    "lockfile": "bun.lock",
    "lockfile_sha256": "",
    "manager": "bun"
   },
   "deps": [
    "npm-fetch"
   ],
   "id": "npm-fetch-prod",
   "name": "select production packages"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "dev": false,
     "type": "node-modules"
    },
    "kind": "layer"
   },
   "deps": [
    "npm-fetch-prod"
   ],
   "id": "layer-deps",
   "name": "layer node_modules (production)"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [
      "**/node_modules",
      ".next/cache"
     ],
     "path": ".",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-app",
   "name": "layer app + build output"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-deps",
    "layer-app",
    "layer-shim"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "the build step runs with network access like docker build; set ACROPOLIS_HERMETIC_BUILD=1 to run it without network"
 ]
}
