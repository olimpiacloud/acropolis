{
 "app": "node-bun-no-deps",
 "facts": {
  "framework": "none",
  "node": "lts (default)",
  "package-manager": "bun",
  "runtime": "bun (no node)",
  "runtime-base": "distroless cc + bun (busybox shell)"
 },
 "image": {
  "cmd": [
   "bun",
   "app.js"
  ],
  "entrypoint": [],
  "env": [
   [
    "NODE_ENV",
    "production"
   ],
   [
    "PATH",
    "/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/busybox"
   ],
   [
    "npm_config_user_agent",
    "bun/ npm/? node/vlts linux x64"
   ],
   [
    "npm_lifecycle_event",
    "start"
   ],
   [
    "npm_package_name",
    "node-bun-no-deps"
   ]
  ],
  "layers": [
   "layer-shim",
   "layer-bun",
   "layer-deps",
   "layer-app"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "image": "gcr.io/distroless/cc-debian12:debug",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve gcr.io/distroless/cc-debian12:debug"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "type": "node-shim"
    },
    "kind": "layer"
   },
   "deps": [
    "base"
   ],
   "id": "layer-shim",
   "name": "layer sh and env links"
  },
  {
   "action": {
    "dev": false,
    "kind": "npm-fetch",
    "lockfile": "",
    "lockfile_sha256": "",
    "manager": "npm"
   },
   "deps": [],
   "id": "npm-fetch",
   "name": "fetch production packages"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "dev": false,
     "type": "node-modules"
    },
    "kind": "layer"
   },
   "deps": [
    "npm-fetch"
   ],
   "id": "layer-deps",
   "name": "layer node_modules (production)"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [
      "**/node_modules"
     ],
     "type": "app-source"
    },
    "kind": "layer"
   },
   "deps": [],
   "id": "layer-app",
   "name": "layer app source"
  },
  {
   "action": {
    "kind": "toolchain",
    "parts": [],
    "spec": ">=1.0.0",
    "tool": "bun"
   },
   "deps": [],
   "id": "bun",
   "name": "bun >=1.0.0"
  },
  {
   "action": {
    "dest": "usr/local/bin",
    "from": {
     "files": [
      [
       "bin/bun",
       "bun"
      ]
     ],
     "tool": "bun",
     "type": "tool"
    },
    "kind": "layer"
   },
   "deps": [
    "bun"
   ],
   "id": "layer-bun",
   "name": "layer bun binary"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-deps",
    "layer-app",
    "layer-bun",
    "layer-shim"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "no lockfile: dependencies are resolved from the npm registry at build time, so the build is not reproducible"
 ]
}
