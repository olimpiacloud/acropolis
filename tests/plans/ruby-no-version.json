{
 "app": "ruby-no-version",
 "facts": {
  "ruby": "3.4 (default)"
 },
 "image": {
  "cmd": [
   "/bin/sh",
   "-c",
   "exec bundle exec rackup config.ru -o 0.0.0.0 -p ${PORT:-3000}"
  ],
  "entrypoint": [],
  "env": [
   [
    "BUNDLE_GEMFILE",
    "/app/Gemfile"
   ],
   [
    "BUNDLE_WITHOUT",
    "development:test"
   ],
   [
    "RACK_ENV",
    "production"
   ],
   [
    "RAILS_ENV",
    "production"
   ],
   [
    "LD_PRELOAD",
    "libjemalloc.so.2"
   ],
   [
    "RUBY_YJIT_ENABLE",
    "1"
   ],
   [
    "RAILS_LOG_TO_STDOUT",
    "enabled"
   ],
   [
    "RAILS_SERVE_STATIC_FILES",
    "true"
   ]
  ],
  "layers": [
   "layer-libs",
   "layer-native-libs",
   "layer-gems",
   "layer-app"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "ruby",
 "steps": [
  {
   "action": {
    "image": "ruby:3.4-slim",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve ruby:3.4-slim"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "exclude": [
     "vendor/bundle",
     "tmp",
     "log/*.log"
    ],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "after": null,
    "commands": [
     "(gem list -i bundler -v 2.3.12 >/dev/null || gem install -N bundler -v 2.3.12)",
     "bundle install --jobs 4",
     "{ find /usr/local/bundle -name '*.so*' -type f 2>/dev/null | xargs -r ldd 2>/dev/null | awk '/=> \\//{print $3}' | sort -u | while read -r f; do dpkg -S \"$f\" 2>/dev/null || dpkg -S \"$(readlink -f \"$f\")\" 2>/dev/null || dpkg -S \"/usr$f\" 2>/dev/null; done | cut -d: -f1 | sort -u > /app/.acropolis-runtime-debs; true; }"
    ],
    "env": {
     "BUNDLE_GEMFILE": "/app/Gemfile",
     "BUNDLE_WITHOUT": "development:test",
     "RACK_ENV": "production",
     "RAILS_ENV": "production"
    },
    "image": "ruby:3.4",
    "kind": "image-run",
    "mount_app": true,
    "network": true,
    "tools": []
   },
   "deps": [
    "source"
   ],
   "id": "install",
   "name": "bundle install (in ruby:3.4)"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [
      ".acropolis-runtime-debs"
     ],
     "path": ".",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "install"
   ],
   "id": "layer-app",
   "name": "layer app"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "exclude": [
      "usr/local/bundle/cache"
     ],
     "include": [
      "usr/local/bundle"
     ],
     "step": "install",
     "type": "upper"
    },
    "kind": "layer"
   },
   "deps": [
    "install"
   ],
   "id": "layer-gems",
   "name": "layer gems (/usr/local/bundle)"
  },
  {
   "action": {
    "after": null,
    "commands": [
     ". /etc/os-release; case \"$VERSION_CODENAME\" in jessie|stretch|buster|bullseye) sed -i -e 's|deb.debian.org|archive.debian.org|g' -e 's|security.debian.org|archive.debian.org|g' -e '/-updates/d' /etc/apt/sources.list; echo 'Acquire::Check-Valid-Until \"false\";' > /etc/apt/apt.conf.d/99acropolis-archive ;; esac; apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends libjemalloc2 >/dev/null && rm -rf /var/lib/apt/lists/*"
    ],
    "env": {},
    "image": "ruby:3.4-slim",
    "kind": "image-run",
    "mount_app": false,
    "network": true,
    "tools": []
   },
   "deps": [],
   "id": "runtime-libs",
   "name": "apt-get install libjemalloc2"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "exclude": [
      "var/cache",
      "var/log",
      "root"
     ],
     "include": [],
     "step": "runtime-libs",
     "type": "upper"
    },
    "kind": "layer"
   },
   "deps": [
    "runtime-libs"
   ],
   "id": "layer-libs",
   "name": "layer runtime libraries"
  },
  {
   "action": {
    "after": null,
    "commands": [
     "m=''; for p in $(cat /app/.acropolis-runtime-debs 2>/dev/null); do dpkg -s \"$p\" >/dev/null 2>&1 || m=\"$m $p\"; done; if [ -n \"$m\" ]; then echo \"installing runtime libraries:$m\"; . /etc/os-release; case \"$VERSION_CODENAME\" in jessie|stretch|buster|bullseye) sed -i -e 's|deb.debian.org|archive.debian.org|g' -e 's|security.debian.org|archive.debian.org|g' -e '/-updates/d' /etc/apt/sources.list; echo 'Acquire::Check-Valid-Until \"false\";' > /etc/apt/apt.conf.d/99acropolis-archive ;; esac; apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends $m >/dev/null && rm -rf /var/lib/apt/lists/*; fi"
    ],
    "env": {},
    "image": "ruby:3.4-slim",
    "kind": "image-run",
    "lowers": [
     "runtime-libs"
    ],
    "mount_app": true,
    "network": true,
    "tools": []
   },
   "deps": [
    "runtime-libs",
    "install"
   ],
   "id": "native-libs",
   "name": "install shared libraries needed by native gems"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "exclude": [
      "var/cache",
      "var/log",
      "root"
     ],
     "include": [],
     "step": "native-libs",
     "type": "upper"
    },
    "kind": "layer"
   },
   "deps": [
    "native-libs"
   ],
   "id": "layer-native-libs",
   "name": "layer native gem libraries"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-libs",
    "layer-native-libs",
    "layer-gems",
    "layer-app"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "gems are installed with network access inside the base image"
 ]
}
