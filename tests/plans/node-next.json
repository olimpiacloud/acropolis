{
 "app": "node-next",
 "facts": {
  "framework": "next",
  "next-output": "standalone (set by acropolis; ACROPOLIS_NEXT_STANDALONE=0 to keep next start)",
  "node": "lts (default)",
  "package-manager": "npm",
  "runtime": "next standalone server",
  "runtime-base": "distroless node (busybox shell)"
 },
 "image": {
  "cmd": [
   "node",
   "server.js"
  ],
  "entrypoint": [],
  "env": [
   [
    "NODE_ENV",
    "production"
   ],
   [
    "PORT",
    "3000"
   ],
   [
    "HOSTNAME",
    "0.0.0.0"
   ],
   [
    "npm_config_user_agent",
    "npm/10 node/vlts linux x64"
   ],
   [
    "npm_lifecycle_event",
    "start"
   ],
   [
    "npm_package_name",
    "node-next"
   ]
  ],
  "layers": [
   "layer-shim",
   "layer-files",
   "layer-server",
   "layer-static"
  ],
  "ports": [
   3000
  ],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "kind": "toolchain",
    "parts": [],
    "spec": "lts",
    "tool": "node"
   },
   "deps": [],
   "id": "node",
   "name": "node lts"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-fetch",
    "lockfile": "package-lock.json",
    "lockfile_sha256": "33a02bb258403d729ac43a4afcec93a0895763b530d56cd1087362ac24626313",
    "manager": "npm"
   },
   "deps": [],
   "id": "npm-fetch",
   "name": "fetch packages"
  },
  {
   "action": {
    "exclude": [
     "**/node_modules"
    ],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-install",
    "manager": "npm",
    "scripts": "",
    "target": "src"
   },
   "deps": [
    "npm-fetch",
    "source"
   ],
   "id": "install",
   "name": "install node_modules"
  },
  {
   "action": {
    "argv": [
     "/bin/sh",
     "-c",
     "next build"
    ],
    "cwd": ".",
    "env": {
     "ACROPOLIS_NFT_CACHE": "{src}/.next/cache/acropolis-nft-analysis.json",
     "NEXT_PRIVATE_STANDALONE": "1",
     "NEXT_TELEMETRY_DISABLED": "1",
     "NODE_ENV": "production",
     "NODE_OPTIONS": "--require {work}/acropolis-nft-cache.js",
     "npm_lifecycle_event": "build",
     "npm_package_name": "node-next"
    },
    "kind": "run",
    "network": true
   },
   "deps": [
    "node",
    "install"
   ],
   "id": "build",
   "name": "run next build"
  },
  {
   "action": {
    "kind": "resolve-node-base",
    "spec": "lts",
    "variant": "distroless"
   },
   "deps": [],
   "id": "base",
   "name": "resolve node lts runtime (distroless)"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "type": "node-shim"
    },
    "kind": "layer"
   },
   "deps": [
    "base"
   ],
   "id": "layer-shim",
   "name": "layer sh, env and node links"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [
      "**/node_modules",
      ".next",
      ".git",
      "public"
     ],
     "path": ".",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-files",
   "name": "layer app files"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [],
     "path": ".next/standalone",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-server",
   "name": "layer .next/standalone"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "items": [
      [
       "public",
       "public"
      ],
      [
       ".next/static",
       ".next/static"
      ]
     ],
     "type": "paths"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-static",
   "name": "layer .next/static + public"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-server",
    "layer-static",
    "layer-files",
    "layer-shim"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "the build step runs with network access like docker build; set ACROPOLIS_HERMETIC_BUILD=1 to run it without network"
 ]
}
