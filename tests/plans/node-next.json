{
 "app": "node-next",
 "facts": {
  "framework": "next",
  "install-scripts": "sharp",
  "node": "lts (default)",
  "package-manager": "npm",
  "runtime": "node server (built)"
 },
 "image": {
  "cmd": [
   "next",
   "start"
  ],
  "entrypoint": [],
  "env": [
   [
    "NODE_ENV",
    "production"
   ],
   [
    "PATH",
    "/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
   ],
   [
    "npm_config_user_agent",
    "npm/10 node/vlts linux x64"
   ],
   [
    "npm_lifecycle_event",
    "start"
   ],
   [
    "npm_package_name",
    "node-next"
   ]
  ],
  "layers": [
   "layer-deps",
   "layer-app"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "kind": "toolchain",
    "parts": [
     "npm",
     "headers"
    ],
    "spec": "lts",
    "tool": "node"
   },
   "deps": [],
   "id": "node",
   "name": "node lts"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-fetch",
    "lockfile": "package-lock.json",
    "lockfile_sha256": "33a02bb258403d729ac43a4afcec93a0895763b530d56cd1087362ac24626313",
    "manager": "npm"
   },
   "deps": [],
   "id": "npm-fetch",
   "name": "fetch packages"
  },
  {
   "action": {
    "exclude": [
     "**/node_modules"
    ],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-install",
    "manager": "npm",
    "scripts": "all",
    "target": "src"
   },
   "deps": [
    "npm-fetch",
    "source",
    "node"
   ],
   "id": "install",
   "name": "install node_modules"
  },
  {
   "action": {
    "argv": [
     "/bin/sh",
     "-c",
     "next build"
    ],
    "cwd": ".",
    "env": {
     "NEXT_TELEMETRY_DISABLED": "1",
     "NODE_ENV": "production",
     "npm_lifecycle_event": "build",
     "npm_package_name": "node-next"
    },
    "kind": "run",
    "network": true
   },
   "deps": [
    "node",
    "install"
   ],
   "id": "build",
   "name": "run next build"
  },
  {
   "action": {
    "image": "node:lts-trixie-slim",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve node:lts-trixie-slim"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dev": false,
    "kind": "npm-fetch",
    "lockfile": "package-lock.json",
    "lockfile_sha256": "",
    "manager": "npm"
   },
   "deps": [
    "npm-fetch"
   ],
   "id": "npm-fetch-prod",
   "name": "select production packages"
  },
  {
   "action": {
    "dev": false,
    "kind": "npm-install",
    "manager": "npm",
    "scripts": "all",
    "target": "prod"
   },
   "deps": [
    "npm-fetch-prod",
    "node"
   ],
   "id": "install-prod",
   "name": "install production node_modules + scripts"
  },
  {
   "action": {
    "dest": "app/node_modules",
    "from": {
     "exclude": [],
     "path": "@work/prod/node_modules",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "install-prod"
   ],
   "id": "layer-deps",
   "name": "layer node_modules (production)"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [
      "**/node_modules",
      ".next/cache"
     ],
     "path": ".",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-app",
   "name": "layer app + build output"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-deps",
    "layer-app"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "install scripts of sharp run with network access (policy: all); set ACRO_INSTALL_SCRIPTS=none to disable",
  "the build step runs with network access (next build may fetch fonts); it is not hermetic"
 ]
}
