{
 "app": "node-bun",
 "facts": {
  "framework": "none",
  "node": "lts (default)",
  "package-manager": "bun"
 },
 "image": {
  "cmd": [
   "bun",
   "index.ts"
  ],
  "entrypoint": [],
  "env": [
   [
    "NODE_ENV",
    "production"
   ],
   [
    "PATH",
    "/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
   ],
   [
    "npm_config_user_agent",
    "bun/latest npm/? node/v{version:node|lts} linux x64"
   ]
  ],
  "layers": [
   "layer-bun",
   "layer-app"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "kind": "toolchain",
    "parts": [],
    "spec": "latest",
    "tool": "bun"
   },
   "deps": [],
   "id": "bun",
   "name": "bun latest"
  },
  {
   "action": {
    "kind": "toolchain",
    "parts": [],
    "spec": "lts",
    "tool": "node"
   },
   "deps": [],
   "id": "node",
   "name": "node lts"
  },
  {
   "action": {
    "exclude": [
     "**/node_modules"
    ],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "argv": [
     "bun",
     "install",
     "--frozen-lockfile"
    ],
    "cwd": ".",
    "env": {},
    "kind": "run",
    "network": true
   },
   "deps": [
    "bun",
    "node",
    "source"
   ],
   "id": "install",
   "name": "bun install --frozen-lockfile"
  },
  {
   "action": {
    "argv": [
     "/bin/sh",
     "-c",
     "bun run build"
    ],
    "cwd": ".",
    "env": {
     "NODE_ENV": "production"
    },
    "kind": "run",
    "network": false
   },
   "deps": [
    "install"
   ],
   "id": "build",
   "name": "run bun run build"
  },
  {
   "action": {
    "image": "node:lts-bookworm-slim",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve node:lts-bookworm-slim"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dest": "usr/local/bin",
    "from": {
     "files": [
      [
       "bin/bun",
       "bun"
      ]
     ],
     "tool": "bun",
     "type": "tool"
    },
    "kind": "layer"
   },
   "deps": [
    "bun"
   ],
   "id": "layer-bun",
   "name": "layer bun binary"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [],
     "path": ".",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-app",
   "name": "layer app + dependencies"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-bun",
    "layer-app"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "bun.lockb is installed by the bun CLI with network access"
 ]
}
