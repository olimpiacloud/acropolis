{
 "app": "node-vite-react-router-spa",
 "facts": {
  "framework": "reactrouter",
  "node": "lts (default)",
  "package-manager": "pnpm",
  "runtime": "static site from build/client served by caddy"
 },
 "image": {
  "cmd": [
   "/bin/sh",
   "-c",
   "exec caddy run --config /Caddyfile --adapter caddyfile 2>&1"
  ],
  "entrypoint": [],
  "env": [],
  "layers": [
   "layer-caddy",
   "layer-site"
  ],
  "ports": [
   80
  ],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "kind": "toolchain",
    "parts": [
     "npm",
     "headers"
    ],
    "spec": "lts",
    "tool": "node"
   },
   "deps": [],
   "id": "node",
   "name": "node lts"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-fetch",
    "lockfile": "pnpm-lock.yaml",
    "lockfile_sha256": "c5ccb451e6cafc1f59279e02fa81bfb75e0dfc608c67fa853f00672a66b51ffd",
    "manager": "pnpm"
   },
   "deps": [],
   "id": "npm-fetch",
   "name": "fetch packages"
  },
  {
   "action": {
    "exclude": [
     "**/node_modules"
    ],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-install",
    "manager": "pnpm",
    "scripts": "all",
    "target": "src"
   },
   "deps": [
    "npm-fetch",
    "source",
    "node"
   ],
   "id": "install",
   "name": "install node_modules"
  },
  {
   "action": {
    "argv": [
     "/bin/sh",
     "-c",
     "react-router build"
    ],
    "cwd": ".",
    "env": {
     "NEXT_TELEMETRY_DISABLED": "1",
     "NODE_ENV": "production",
     "npm_lifecycle_event": "build",
     "npm_package_name": "node-vite-react-router-spa"
    },
    "kind": "run",
    "network": true
   },
   "deps": [
    "node",
    "install"
   ],
   "id": "build",
   "name": "run react-router build"
  },
  {
   "action": {
    "image": "caddy:2-alpine",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve caddy:2-alpine"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "files": {
      "Caddyfile": "{\n\tadmin off\n\tpersist_config off\n\tauto_https off\n\tlog {\n\t\tformat json\n\t}\n}\n\n:{$PORT:80} {\n\tlog {\n\t\tformat json\n\t}\n\trespond /health 200\n\theader {\n\t\tX-Content-Type-Options \"nosniff\"\n\t\t-Server\n\t}\n\troot * /app/dist\n\tfile_server {\n\t\thide .git\n\t\thide .env*\n\t}\n\tencode {\n\t\tgzip\n\t\tzstd\n\t}\n\ttry_files {path} {path}.html {path}/index.html /index.html\n}\n"
     },
     "type": "inline"
    },
    "kind": "layer"
   },
   "deps": [],
   "id": "layer-caddy",
   "name": "layer Caddyfile"
  },
  {
   "action": {
    "dest": "app/dist",
    "from": {
     "exclude": [],
     "path": "build/client",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-site",
   "name": "layer build/client"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-caddy",
    "layer-site"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "the build step runs with network access like docker build; set ACRO_HERMETIC_BUILD=1 to run it without network"
 ]
}
