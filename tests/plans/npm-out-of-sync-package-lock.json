{
 "app": "npm-out-of-sync-package-lock",
 "facts": {
  "framework": "none",
  "node": "lts (default)",
  "package-manager": "npm",
  "runtime": "node server (no build step)"
 },
 "image": {
  "cmd": [
   "node",
   "index.js"
  ],
  "entrypoint": [],
  "env": [
   [
    "NODE_ENV",
    "production"
   ],
   [
    "PATH",
    "/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
   ],
   [
    "npm_config_user_agent",
    "npm/10 node/vlts linux x64"
   ],
   [
    "npm_lifecycle_event",
    "start"
   ],
   [
    "npm_package_name",
    "npm-out-of-sync-package-lock"
   ]
  ],
  "layers": [
   "layer-deps",
   "layer-app"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "image": "node:lts-bookworm-slim",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve node:lts-bookworm-slim"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dev": false,
    "kind": "npm-fetch",
    "lockfile": "package-lock.json",
    "lockfile_sha256": "6fdc3a71315afc1cc8be744a0f5feec85d6622dc3a5167ba65e823915b8ede0f",
    "manager": "npm"
   },
   "deps": [],
   "id": "npm-fetch",
   "name": "fetch production packages"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "dev": false,
     "type": "node-modules"
    },
    "kind": "layer"
   },
   "deps": [
    "npm-fetch"
   ],
   "id": "layer-deps",
   "name": "layer node_modules (production)"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [
      "**/node_modules"
     ],
     "type": "app-source"
    },
    "kind": "layer"
   },
   "deps": [],
   "id": "layer-app",
   "name": "layer app source"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-deps",
    "layer-app"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": []
}
