{
 "app": "node-npm-install-in-build",
 "facts": {
  "framework": "none",
  "node": "23.5.0 (package.json engines.node)",
  "package-manager": "npm",
  "runtime": "node server (built)",
  "runtime-base": "distroless cc + node of the build toolchain (busybox shell)"
 },
 "image": {
  "cmd": [
   "node",
   "index.js"
  ],
  "entrypoint": [],
  "env": [
   [
    "NODE_ENV",
    "production"
   ],
   [
    "PATH",
    "/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/busybox"
   ],
   [
    "npm_config_user_agent",
    "npm/10 node/v{version:node|23.5.0} linux x64"
   ],
   [
    "npm_lifecycle_event",
    "start"
   ],
   [
    "npm_package_name",
    "node-npm"
   ]
  ],
  "layers": [
   "layer-node-bin",
   "layer-shim",
   "layer-deps",
   "layer-app"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "kind": "toolchain",
    "parts": [
     "npm"
    ],
    "spec": "23.5.0",
    "tool": "node"
   },
   "deps": [],
   "id": "node",
   "name": "node 23.5.0"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-fetch",
    "lockfile": "package-lock.json",
    "lockfile_sha256": "5cca16aa90041764cc8ef6947af3839496e21891b6823975f98194dd498686a5",
    "manager": "npm"
   },
   "deps": [],
   "id": "npm-fetch",
   "name": "fetch packages"
  },
  {
   "action": {
    "exclude": [
     "**/node_modules"
    ],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-install",
    "manager": "npm",
    "scripts": "",
    "target": "src"
   },
   "deps": [
    "npm-fetch",
    "source"
   ],
   "id": "install",
   "name": "install node_modules"
  },
  {
   "action": {
    "argv": [
     "/bin/sh",
     "-c",
     "npm ci"
    ],
    "cwd": ".",
    "env": {
     "NEXT_TELEMETRY_DISABLED": "1",
     "NODE_ENV": "production",
     "npm_lifecycle_event": "build",
     "npm_package_name": "node-npm"
    },
    "kind": "run",
    "network": true
   },
   "deps": [
    "node",
    "install"
   ],
   "id": "build",
   "name": "run npm ci"
  },
  {
   "action": {
    "image": "gcr.io/distroless/cc-debian12:debug",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve gcr.io/distroless/cc-debian12:debug"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "type": "node-shim"
    },
    "kind": "layer"
   },
   "deps": [
    "base"
   ],
   "id": "layer-shim",
   "name": "layer sh and env links"
  },
  {
   "action": {
    "dest": "usr/local/bin",
    "from": {
     "files": [
      [
       "bin/node",
       "node"
      ]
     ],
     "tool": "node",
     "type": "tool"
    },
    "kind": "layer"
   },
   "deps": [
    "node"
   ],
   "id": "layer-node-bin",
   "name": "layer node from the build toolchain"
  },
  {
   "action": {
    "dev": false,
    "kind": "npm-fetch",
    "lockfile": "package-lock.json",
    "lockfile_sha256": "",
    "manager": "npm"
   },
   "deps": [
    "npm-fetch"
   ],
   "id": "npm-fetch-prod",
   "name": "select production packages"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "dev": false,
     "type": "node-modules"
    },
    "kind": "layer"
   },
   "deps": [
    "npm-fetch-prod"
   ],
   "id": "layer-deps",
   "name": "layer node_modules (production)"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [
      "**/node_modules",
      ".next/cache"
     ],
     "path": ".",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-app",
   "name": "layer app + build output"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-deps",
    "layer-app",
    "layer-shim",
    "layer-node-bin"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "the build step runs with network access like docker build; set ACROPOLIS_HERMETIC_BUILD=1 to run it without network"
 ]
}
