{
 "app": "rust-cargo-workspaces-glob",
 "facts": {
  "binary": "binary",
  "host-glibc": "2.39",
  "rust": "1.88.0 (.tool-versions)"
 },
 "image": {
  "cmd": [
   "/app/bin/binary"
  ],
  "entrypoint": [],
  "env": [
   [
    "ROCKET_ADDRESS",
    "0.0.0.0"
   ]
  ],
  "layers": [
   "layer-bin"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "rust",
 "steps": [
  {
   "action": {
    "image": "gcr.io/distroless/cc-debian13",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve gcr.io/distroless/cc-debian13"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "kind": "cargo-vendor",
    "lockfile_sha256": "7593b90ff541dc5a3c290462af28df2cb8f35f3ded229a350405a5f7ae3af467"
   },
   "deps": [],
   "id": "crates",
   "name": "fetch crates"
  },
  {
   "action": {
    "kind": "toolchain",
    "parts": [],
    "spec": "1.88.0",
    "tool": "rust"
   },
   "deps": [],
   "id": "rust",
   "name": "rust 1.88.0"
  },
  {
   "action": {
    "argv": [
     "cargo",
     "build",
     "--release",
     "--locked",
     "--offline",
     "--package",
     "binary"
    ],
    "cwd": "@app",
    "env": {},
    "kind": "run",
    "network": false
   },
   "deps": [
    "rust",
    "crates"
   ],
   "id": "build",
   "name": "cargo build --release (binary)"
  },
  {
   "action": {
    "dest": "app/bin/binary",
    "from": {
     "mode": 493,
     "path": "{cargo_target}/release/binary",
     "type": "work-file"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-bin",
   "name": "layer binary"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-bin"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": []
}
