{
 "app": "rust-custom-version",
 "facts": {
  "binary": "rust-custom-version",
  "host-glibc": "2.39",
  "rust": "1.56.0 (Cargo.toml rust-version)"
 },
 "image": {
  "cmd": [
   "/app/bin/rust-custom-version"
  ],
  "entrypoint": [],
  "env": [
   [
    "ROCKET_ADDRESS",
    "0.0.0.0"
   ]
  ],
  "layers": [
   "layer-bin"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "rust",
 "steps": [
  {
   "action": {
    "image": "gcr.io/distroless/cc-debian13",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve gcr.io/distroless/cc-debian13"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "kind": "toolchain",
    "parts": [],
    "spec": "1.56.0",
    "tool": "rust"
   },
   "deps": [],
   "id": "rust",
   "name": "rust 1.56.0"
  },
  {
   "action": {
    "kind": "cargo-vendor",
    "lockfile_sha256": "eebc75f82d66fc32ae8933ce690156546a34ecad92f6514b6eafd17cd6c1cd84"
   },
   "deps": [],
   "id": "crates",
   "name": "fetch crates"
  },
  {
   "action": {
    "argv": [
     "cargo",
     "build",
     "--release",
     "--locked",
     "--offline",
     "--bin",
     "rust-custom-version"
    ],
    "cwd": "@app",
    "env": {},
    "kind": "run",
    "network": false
   },
   "deps": [
    "rust",
    "crates"
   ],
   "id": "build",
   "name": "cargo build --release (rust-custom-version)"
  },
  {
   "action": {
    "dest": "app/bin/rust-custom-version",
    "from": {
     "mode": 493,
     "path": "{cargo_target}/release/rust-custom-version",
     "type": "work-file"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-bin",
   "name": "layer binary"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-bin"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": []
}
