{
 "app": "elixir-phoenix",
 "facts": {
  "app": "hello",
  "apt-packages": "libstdc++6 openssl libncurses6 ca-certificates",
  "elixir": "1.16",
  "runtime-packages": "libstdc++6 openssl libncurses6 ca-certificates"
 },
 "image": {
  "cmd": [
   "/bin/sh",
   "-c",
   "/app/_build/prod/rel/hello/bin/hello start"
  ],
  "entrypoint": [],
  "env": [
   [
    "MIX_ENV",
    "prod"
   ],
   [
    "LANG",
    "C.UTF-8"
   ],
   [
    "PORT",
    "4000"
   ]
  ],
  "layers": [
   "layer-apt",
   "layer-app"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "elixir",
 "steps": [
  {
   "action": {
    "image": "@slim-of:elixir:1.16",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve runtime image"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "exclude": [],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "after": null,
    "commands": [
     "mkdir -p config deps _build",
     "mix local.hex --force",
     "mix local.rebar --force",
     "mix deps.get --only prod",
     "mix deps.compile",
     "mix compile",
     "mix assets.deploy",
     "mix release --overwrite"
    ],
    "env": {
     "ELIXIR_ERL_OPTIONS": "+fnu",
     "HEX_HOME": "/root/.hex",
     "LANG": "C.UTF-8",
     "MIX_ENV": "prod",
     "MIX_HOME": "/root/.mix"
    },
    "image": "elixir:1.16",
    "kind": "image-run",
    "mount_app": true,
    "network": true,
    "tools": []
   },
   "deps": [
    "source"
   ],
   "id": "build",
   "name": "build in elixir:1.16"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "items": [
      [
       "_build/prod/rel/hello",
       "_build/prod/rel/hello"
      ]
     ],
     "type": "paths"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-app",
   "name": "layer build output"
  },
  {
   "action": {
    "after": null,
    "commands": [
     ". /etc/os-release; case \"$VERSION_CODENAME\" in jessie|stretch|buster|bullseye) sed -i -e 's|deb.debian.org|archive.debian.org|g' -e 's|security.debian.org|archive.debian.org|g' -e '/-updates/d' /etc/apt/sources.list; echo 'Acquire::Check-Valid-Until \"false\";' > /etc/apt/apt.conf.d/99acropolis-archive ;; esac; apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libstdc++6 openssl libncurses6 ca-certificates && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb /var/log/apt /var/log/dpkg.log"
    ],
    "env": {},
    "image": "@base",
    "kind": "image-run",
    "mount_app": false,
    "network": true,
    "tools": []
   },
   "deps": [
    "base"
   ],
   "id": "apt",
   "name": "apt-get install libstdc++6 openssl libncurses6 ca-certificates"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "exclude": [
      "var/cache",
      "var/log",
      "root"
     ],
     "include": [],
     "step": "apt",
     "type": "upper"
    },
    "kind": "layer"
   },
   "deps": [
    "apt"
   ],
   "id": "layer-apt",
   "name": "layer apt packages"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-app",
    "layer-apt"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "elixir dependencies are fetched with network access inside the build image"
 ]
}
