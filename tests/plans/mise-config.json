{
 "app": "mise-config",
 "facts": {
  "framework": "none",
  "mise-extras": "go python",
  "node": "24 (mise.toml)",
  "package-manager": "npm",
  "runtime": "bun (no node)"
 },
 "image": {
  "cmd": [
   "bun",
   "run",
   "index.ts"
  ],
  "entrypoint": [],
  "env": [
   [
    "NODE_ENV",
    "production"
   ],
   [
    "PATH",
    "/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/go/bin:/opt/python/bin"
   ],
   [
    "npm_config_user_agent",
    "npm/10 node/v{version:node|24} linux x64"
   ],
   [
    "npm_lifecycle_event",
    "start"
   ],
   [
    "npm_package_name",
    "node-bun"
   ]
  ],
  "layers": [
   "layer-mise-python",
   "layer-mise-go",
   "layer-bun",
   "layer-deps",
   "layer-app"
  ],
  "ports": [],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "kind": "toolchain",
    "parts": [],
    "spec": "3.13",
    "tool": "python-standalone"
   },
   "deps": [],
   "id": "mise-python",
   "name": "python 3.13 (mise)"
  },
  {
   "action": {
    "kind": "toolchain",
    "parts": [],
    "spec": "1.25",
    "tool": "go"
   },
   "deps": [],
   "id": "mise-go",
   "name": "go 1.25 (mise)"
  },
  {
   "action": {
    "image": "node:24-bookworm-slim",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve node:24-bookworm-slim"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dev": false,
    "kind": "npm-fetch",
    "lockfile": "",
    "lockfile_sha256": "",
    "manager": "npm"
   },
   "deps": [],
   "id": "npm-fetch",
   "name": "fetch production packages"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "dev": false,
     "type": "node-modules"
    },
    "kind": "layer"
   },
   "deps": [
    "npm-fetch"
   ],
   "id": "layer-deps",
   "name": "layer node_modules (production)"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [
      "**/node_modules"
     ],
     "type": "app-source"
    },
    "kind": "layer"
   },
   "deps": [],
   "id": "layer-app",
   "name": "layer app source"
  },
  {
   "action": {
    "kind": "toolchain",
    "parts": [],
    "spec": "latest",
    "tool": "bun"
   },
   "deps": [],
   "id": "bun",
   "name": "bun latest"
  },
  {
   "action": {
    "dest": "usr/local/bin",
    "from": {
     "files": [
      [
       "bin/bun",
       "bun"
      ]
     ],
     "tool": "bun",
     "type": "tool"
    },
    "kind": "layer"
   },
   "deps": [
    "bun"
   ],
   "id": "layer-bun",
   "name": "layer bun binary"
  },
  {
   "action": {
    "dest": "usr/local/go",
    "from": {
     "tool": "go",
     "type": "tool-tree"
    },
    "kind": "layer"
   },
   "deps": [
    "mise-go"
   ],
   "id": "layer-mise-go",
   "name": "layer go (mise)"
  },
  {
   "action": {
    "dest": "opt/python",
    "from": {
     "tool": "python-standalone",
     "type": "tool-tree"
    },
    "kind": "layer"
   },
   "deps": [
    "mise-python"
   ],
   "id": "layer-mise-python",
   "name": "layer python (mise)"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-deps",
    "layer-app",
    "layer-bun",
    "layer-mise-go",
    "layer-mise-python"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "no lockfile: dependencies are resolved from the npm registry at build time, so the build is not reproducible"
 ]
}
