{
 "app": "php-vanilla",
 "facts": {
  "apt-packages": "jq",
  "php": "8.4"
 },
 "image": {
  "cmd": [
   "/start-container.sh"
  ],
  "entrypoint": [],
  "env": [
   [
    "APP_ENV",
    "production"
   ],
   [
    "APP_DEBUG",
    "false"
   ],
   [
    "LOG_CHANNEL",
    "stderr"
   ],
   [
    "SERVER_NAME",
    ":80"
   ],
   [
    "OCTANE_SERVER",
    "frankenphp"
   ],
   [
    "IS_LARAVEL",
    "false"
   ]
  ],
  "layers": [
   "layer-apt",
   "layer-system",
   "layer-config",
   "layer-app"
  ],
  "ports": [
   80
  ],
  "user": null,
  "workdir": "/app"
 },
 "provider": "php",
 "steps": [
  {
   "action": {
    "image": "dunglas/frankenphp:php8.4-trixie",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve dunglas/frankenphp:php8.4-trixie"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "exclude": [
     "vendor",
     "**/node_modules"
    ],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "after": null,
    "commands": [
     "true"
    ],
    "env": {
     "COMPOSER_ALLOW_SUPERUSER": "1",
     "COMPOSER_HOME": "/tmp/composer"
    },
    "image": "@base",
    "kind": "image-run",
    "mount_app": true,
    "network": true,
    "tools": []
   },
   "deps": [
    "source",
    "base"
   ],
   "id": "php-setup",
   "name": "php extensions + composer install"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "exclude": [
      "var/cache",
      "var/log",
      "var/lib/apt/lists",
      "root"
     ],
     "include": [],
     "step": "php-setup",
     "type": "upper"
    },
    "kind": "layer"
   },
   "deps": [
    "php-setup"
   ],
   "id": "layer-system",
   "name": "layer PHP extensions"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "files": {
      "Caddyfile": "{\n\tadmin off\n\tpersist_config off\n\tauto_https off\n\t{$CADDY_GLOBAL_OPTIONS}\n\tlog {\n\t\tformat json\n\t\toutput stderr\n\t}\n\tfrankenphp {\n\t\t{$FRANKENPHP_CONFIG}\n\t}\n}\n\n{$CADDY_EXTRA_CONFIG}\n\n:{$PORT:80} {\n\troot * /app\n\tencode zstd br gzip\n\tfile_server {\n\t\thide .git\n\t\thide .env*\n\t}\n\t{$CADDY_SERVER_EXTRA_DIRECTIVES}\n\tphp_server\n}\n",
      "start-container.sh": "#!/bin/sh\nset -e\nif [ \"$IS_LARAVEL\" = \"true\" ]; then\n  if [ \"$ACROPOLIS_SKIP_MIGRATIONS\" != \"true\" ] && [ \"$RAILPACK_SKIP_MIGRATIONS\" != \"true\" ]; then\n    php artisan migrate --force\n  fi\n  php artisan storage:link || true\n  php artisan optimize:clear\n  php artisan optimize\nfi\nexec docker-php-entrypoint --config /Caddyfile --adapter caddyfile 2>&1\n"
     },
     "type": "inline"
    },
    "kind": "layer"
   },
   "deps": [],
   "id": "layer-config",
   "name": "layer Caddyfile + start script"
  },
  {
   "action": {
    "dest": "app",
    "from": {
     "exclude": [
      "**/node_modules"
     ],
     "path": ".",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "php-setup"
   ],
   "id": "layer-app",
   "name": "layer app"
  },
  {
   "action": {
    "after": null,
    "commands": [
     ". /etc/os-release; case \"$VERSION_CODENAME\" in jessie|stretch|buster|bullseye) sed -i -e 's|deb.debian.org|archive.debian.org|g' -e 's|security.debian.org|archive.debian.org|g' -e '/-updates/d' /etc/apt/sources.list; echo 'Acquire::Check-Valid-Until \"false\";' > /etc/apt/apt.conf.d/99acropolis-archive ;; esac; apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends jq && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb /var/log/apt /var/log/dpkg.log"
    ],
    "env": {},
    "image": "dunglas/frankenphp:php8.4-trixie",
    "kind": "image-run",
    "mount_app": false,
    "network": true,
    "tools": []
   },
   "deps": [],
   "id": "apt",
   "name": "apt-get install jq"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "exclude": [
      "var/cache",
      "var/log",
      "root"
     ],
     "include": [],
     "step": "apt",
     "type": "upper"
    },
    "kind": "layer"
   },
   "deps": [
    "apt"
   ],
   "id": "layer-apt",
   "name": "layer apt packages"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-system",
    "layer-config",
    "layer-app",
    "layer-apt"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "PHP extensions and composer packages are installed with network access inside the base image"
 ]
}
