{
 "app": "node-nuxt",
 "facts": {
  "framework": "nuxt",
  "install-scripts": "vue-demi, @parcel/watcher, esbuild, vue-demi, vue-demi",
  "node": "lts (default)",
  "package-manager": "npm",
  "runtime": "nitro server"
 },
 "image": {
  "cmd": [
   "node",
   ".output/server/index.mjs"
  ],
  "entrypoint": [],
  "env": [
   [
    "NODE_ENV",
    "production"
   ],
   [
    "PORT",
    "3000"
   ],
   [
    "npm_config_user_agent",
    "npm/10 node/vlts linux x64"
   ],
   [
    "npm_lifecycle_event",
    "start"
   ],
   [
    "npm_package_name",
    "nuxt-app"
   ]
  ],
  "layers": [
   "layer-server"
  ],
  "ports": [
   3000
  ],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "kind": "toolchain",
    "parts": [
     "npm",
     "headers"
    ],
    "spec": "lts",
    "tool": "node"
   },
   "deps": [],
   "id": "node",
   "name": "node lts"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-fetch",
    "lockfile": "package-lock.json",
    "lockfile_sha256": "667a69989dd6145cb6cf8fad9c93b0e96967cff415a0d94b75641a750e7f44d5",
    "manager": "npm"
   },
   "deps": [],
   "id": "npm-fetch",
   "name": "fetch packages"
  },
  {
   "action": {
    "exclude": [
     "**/node_modules"
    ],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-install",
    "manager": "npm",
    "scripts": "all",
    "target": "src"
   },
   "deps": [
    "npm-fetch",
    "source",
    "node"
   ],
   "id": "install",
   "name": "install node_modules"
  },
  {
   "action": {
    "argv": [
     "/bin/sh",
     "-c",
     "nuxt build"
    ],
    "cwd": ".",
    "env": {
     "NEXT_TELEMETRY_DISABLED": "1",
     "NODE_ENV": "production",
     "npm_lifecycle_event": "build",
     "npm_package_name": "nuxt-app"
    },
    "kind": "run",
    "network": true
   },
   "deps": [
    "node",
    "install"
   ],
   "id": "build",
   "name": "run nuxt build"
  },
  {
   "action": {
    "image": "node:lts-trixie-slim",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve node:lts-trixie-slim"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dest": "app/.output",
    "from": {
     "exclude": [],
     "path": ".output",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "build"
   ],
   "id": "layer-server",
   "name": "layer .output"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-server"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": [
  "install scripts of vue-demi, @parcel/watcher, esbuild, vue-demi, vue-demi run with network access (policy: all); set ACRO_INSTALL_SCRIPTS=none to disable",
  "the build step runs with network access like docker build; set ACRO_HERMETIC_BUILD=1 to run it without network"
 ]
}
