{
 "app": "node-vite-react",
 "facts": {
  "bundler": "acropolis (rolldown, lazy install)",
  "framework": "vite",
  "node": "lts (default)",
  "package-manager": "npm",
  "runtime": "static site from dist served by caddy",
  "type-check": "tsc -b"
 },
 "image": {
  "cmd": [
   "/bin/sh",
   "-c",
   "exec caddy run --config /Caddyfile --adapter caddyfile 2>&1"
  ],
  "entrypoint": [],
  "env": [],
  "layers": [
   "layer-caddy",
   "layer-site"
  ],
  "ports": [
   80
  ],
  "user": null,
  "workdir": "/app"
 },
 "provider": "node",
 "steps": [
  {
   "action": {
    "kind": "bundle-spa",
    "lockfile": "package-lock.json",
    "manager": "npm",
    "out": "dist"
   },
   "deps": [],
   "id": "bundle",
   "name": "bundle with lazy package fetch"
  },
  {
   "action": {
    "kind": "toolchain",
    "parts": [],
    "spec": "lts",
    "tool": "node"
   },
   "deps": [],
   "id": "node",
   "name": "node lts"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-fetch",
    "lockfile": "package-lock.json",
    "lockfile_sha256": "c174360e7c9b97cfcea18831a7a53274063a00de1e61ccb3de2d125c5004bd9c",
    "manager": "npm"
   },
   "deps": [],
   "id": "npm-fetch",
   "name": "fetch packages"
  },
  {
   "action": {
    "exclude": [
     "**/node_modules"
    ],
    "kind": "copy-source"
   },
   "deps": [],
   "id": "source",
   "name": "copy source"
  },
  {
   "action": {
    "dev": true,
    "kind": "npm-install",
    "manager": "npm",
    "scripts": "",
    "target": "src",
    "types_only": true
   },
   "deps": [
    "npm-fetch",
    "source"
   ],
   "id": "install",
   "name": "install node_modules"
  },
  {
   "action": {
    "argv": [
     "/bin/sh",
     "-c",
     "tsc -b"
    ],
    "cwd": ".",
    "env": {
     "NODE_ENV": "production"
    },
    "kind": "run",
    "network": false
   },
   "deps": [
    "node",
    "install"
   ],
   "id": "typecheck",
   "name": "run tsc -b (in parallel with the bundle)"
  },
  {
   "action": {
    "image": "caddy:2-alpine",
    "kind": "resolve-base"
   },
   "deps": [],
   "id": "base",
   "name": "resolve caddy:2-alpine"
  },
  {
   "action": {
    "kind": "copy-base"
   },
   "deps": [
    "base"
   ],
   "id": "copy-base",
   "name": "copy base layers"
  },
  {
   "action": {
    "dest": "",
    "from": {
     "files": {
      "Caddyfile": "{\n\tadmin off\n\tpersist_config off\n\tauto_https off\n\tlog {\n\t\tformat json\n\t}\n}\n\n:{$PORT:80} {\n\tlog {\n\t\tformat json\n\t}\n\trespond /health 200\n\theader {\n\t\tX-Content-Type-Options \"nosniff\"\n\t\t-Server\n\t}\n\troot * /app/dist\n\tfile_server {\n\t\thide .git\n\t\thide .env*\n\t}\n\tencode {\n\t\tgzip\n\t\tzstd\n\t}\n\ttry_files {path} {path}.html {path}/index.html /index.html\n}\n"
     },
     "type": "inline"
    },
    "kind": "layer"
   },
   "deps": [],
   "id": "layer-caddy",
   "name": "layer Caddyfile"
  },
  {
   "action": {
    "dest": "app/dist",
    "from": {
     "exclude": [],
     "path": "@work/bundle/dist",
     "type": "work-dir"
    },
    "kind": "layer"
   },
   "deps": [
    "bundle",
    "typecheck"
   ],
   "id": "layer-site",
   "name": "layer dist"
  },
  {
   "action": {
    "kind": "push"
   },
   "deps": [
    "base",
    "copy-base",
    "layer-caddy",
    "layer-site"
   ],
   "id": "push",
   "name": "push image"
  }
 ],
 "warnings": []
}
